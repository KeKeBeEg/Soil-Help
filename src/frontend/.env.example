# Set to 1 only if the elevation (DEM) tiles fail to load because of CORS.
# It routes them through this app's own /api/dem proxy instead.
NEXT_PUBLIC_DEM_PROXY=0

# Where the Python backend lives, once it is wired up.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Field analysis (server only; set these in Vercel → Settings → Environment
# Variables, for Production and Preview). Never prefix them with NEXT_PUBLIC_,
# and never commit real values: the repo is public.
# ---------------------------------------------------------------------------

# Cloudflare R2, the "soilhelp-api" token (Object Read & Write on soilhelp-results only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_RESULTS=soilhelp-results

# GitHub fine-grained token: KeKeBeEg/Soil-Help only, Actions read & write, Contents read.
GITHUB_TOKEN=
GITHUB_REPO=KeKeBeEg/Soil-Help
GITHUB_WORKFLOW=field-run.yml
GITHUB_REF=main

# How many fields may run at once (field-run "slots"), and the largest field accepted.
FIELD_SLOTS=3
MAX_FIELD_AREA_HA=500

# Optional: if set, POST /api/fields needs this in the x-demo-passcode header.
DEMO_PASSCODE=
